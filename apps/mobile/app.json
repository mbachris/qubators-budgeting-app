{
  "name": "BudgetSafe",
  "slug": "qubators-budgeting-app",
  "version": "1.0.0",
  "orientation": "portrait",
  "scheme": "qubators",
  "platforms": [
    "android"
  ],
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "android": {
    "package": "com.qubators.budgeting",
    "versionCode": 6,
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#16A34A"
    }
  },
  "plugins": [
    "expo-sqlite",
    "expo-secure-store",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#16A34A"
      }
    ],
    "expo-sharing"
  ],
  "extra": {
    "eas": {
      "projectId": "8f04bb9e-f10e-4d35-a756-949eba600f34"
    }
  },
  "owner": "mbachris"
}
